{
  "info": {
    "name": "Travel Planner — JWT (Лаба 8)",
    "description": "Запит №1 повертає JWT-токен і зберігає його у змінній jwtToken. Скопіюйте токен з відповіді й вставте на https://jwt.io. Решта запитів використовують токен у заголовку Authorization: Bearer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Отримати JWT (admin) → 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Є токен\", function () { pm.expect(pm.response.json().token).to.be.a(\"string\"); });",
              "pm.collectionVariables.set(\"jwtToken\", pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/authenticate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "authenticate"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2. GET /api/trips з Bearer-токеном → 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/trips",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trips"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwtToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "3. POST /api/trips з Bearer-токеном → 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"createdBy = admin (з токена)\", function () { pm.expect(pm.response.json().createdBy).to.eql(\"admin\"); });",
              "pm.collectionVariables.set(\"tripId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trips",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trips"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwtToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Київ — вихідні (JWT)\",\n  \"description\": \"Створено із JWT-токеном\",\n  \"startDate\": \"2026-12-18\",\n  \"endDate\": \"2026-12-21\",\n  \"budget\": 6000,\n  \"status\": \"PLANNED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "4. DELETE /api/trips/{id} з токеном admin → 403",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 403\", function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/trips/{{tripId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trips",
            "{{tripId}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwtToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "5. Неправильний пароль → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/authenticate",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "authenticate"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrong\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "6. Підроблений токен → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/trips",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trips"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwtToken}}abc",
              "type": "string"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "jwtToken",
      "value": ""
    },
    {
      "key": "tripId",
      "value": "1"
    }
  ]
}