  },
  "item": [
    {
      "name": "01. Без авторизації → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"Є заголовок WWW-Authenticate: Basic\", function () { pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.include(\"Basic\"); });"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/trips",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trips"
          ]
        }
      }
    },
