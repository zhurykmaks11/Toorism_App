###7. ADMIN: DELETE trip → 403 (видаляє лише SUPERADMIN)
DELETE http://localhost:8080/api/trips/{{tripId}}
Authorization: Basic admin admin123
X-XSRF-TOKEN: {{xsrfToken}}
Accept: application/json

> {%
    client.test("7. ADMIN: DELETE trip → 403 (видаляє лише SUPERADMIN)", function () {
        client.assert(response.status === 403, "Очікувався 403, отримано " + response.status);
        client.assert(response.body.message.indexOf("не має права") >= 0, "403 має бути через роль, а не через CSRF");
    });
%}

