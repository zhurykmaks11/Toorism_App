###1. USER: GET all trips → 200
GET http://localhost:8080/api/trips
Authorization: Basic user user123
Accept: application/json

> {%
    client.test("1. USER: GET all trips → 200", function () {
        client.assert(response.status === 200, "Очікувався 200, отримано " + response.status);
    });
    // CSRF-токен (лаба №4) для наступних POST / PUT / DELETE
    client.global.set("xsrfToken", response.headers.valueOf("X-XSRF-TOKEN"));
%}

###2. USER: GET one trip → 200
GET http://localhost:8080/api/trips/1
Authorization: Basic user user123
Accept: application/json

> {%
    client.test("2. USER: GET one trip → 200", function () {
        client.assert(response.status === 200, "Очікувався 200, отримано " + response.status);
        client.assert(response.body.id === 1, "Очікувалась подорож з id = 1");
    });
%}

###3. USER: CREATE trip → 403 (немає прав)
POST http://localhost:8080/api/trips
Authorization: Basic user user123
X-XSRF-TOKEN: {{xsrfToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Київ — вихідні",
  "description": "Музеї, лавра і Поділ",
  "startDate": "2026-12-18",
  "endDate": "2026-12-21",
  "budget": 6000,
  "status": "PLANNED"
}

> {%
    client.test("3. USER: CREATE trip → 403 (немає прав)", function () {
        client.assert(response.status === 403, "Очікувався 403, отримано " + response.status);
        client.assert(response.body.message.indexOf("не має права") >= 0, "403 має бути через роль, а не через CSRF");
    });
%}

###4. ADMIN: CREATE trip → 201
POST http://localhost:8080/api/trips
Authorization: Basic admin admin123
X-XSRF-TOKEN: {{xsrfToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Київ — вихідні",
  "description": "Музеї, лавра і Поділ",
  "startDate": "2026-12-18",
  "endDate": "2026-12-21",
  "budget": 6000,
  "status": "PLANNED"
}

> {%
    client.test("4. ADMIN: CREATE trip → 201", function () {
        client.assert(response.status === 201, "Очікувався 201, отримано " + response.status);
        client.assert(response.body.createdBy === "admin", "createdBy має бути admin");
    });
    client.global.set("tripId", response.body.id);
%}

###5. ADMIN: UPDATE trip → 200
PUT http://localhost:8080/api/trips/{{tripId}}
Authorization: Basic admin admin123
X-XSRF-TOKEN: {{xsrfToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Київ — довгі вихідні",
  "description": "Музеї, лавра, Поділ і Андріївський узвіз",
  "startDate": "2026-12-18",
  "endDate": "2026-12-22",
  "budget": 7500,
  "status": "ONGOING"
}

> {%
    client.test("5. ADMIN: UPDATE trip → 200", function () {
        client.assert(response.status === 200, "Очікувався 200, отримано " + response.status);
        client.assert(response.body.updatedBy === "admin", "updatedBy має бути admin");
    });
%}

